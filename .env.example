# Database (SQLite by default — zero setup)
DATABASE_URL="file:./dev.db"

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string-min-32-chars"

# AI provider (optional — app works offline with built-in clinical rule engine)
# Use any OpenAI-compatible endpoint. Leave blank to use local fallback.
LLM_API_KEY=""
LLM_BASE_URL="https://api.openai.com/v1"
LLM_MODEL="gpt-4o-mini"
LLM_TIMEOUT_MS="25000"

# App
NEXT_PUBLIC_APP_NAME="ClinIQ History"
NEXT_PUBLIC_HOSPITAL_NAME="CityCare General Hospital"
