    "lucide-react": "^0.469.0",
    "next": "15.5.4",
    "next-themes": "^0.4.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.54.2",
    "recharts": "^2.15.0",
    "tesseract.js": "^5.1.1",
