{
  "name": "cliniq-history",
  "version": "1.0.0",
  "private": true,
  "description": "ClinIQ History — AI-assisted clinical history-taking for Indian hospitals",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
